{
  "info": {
    "name": "Ejercicio 21 - Aplicaciones (hexagonal PHP)",
    "description": "Pruebas del CRUD de Aplicación. La app usa sesión (cookie PHPSESSID) y formularios; las respuestas son redirecciones 302 o HTML. Ejecuta las carpetas en orden con Collection Runner (0 -> 1 -> 2).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Autenticación",
      "item": [
        {
          "name": "0.1 Sin sesión: listar aplicaciones exige login",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?route=aplicaciones.index",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "route",
                  "value": "aplicaciones.index"
                }
              ]
            },
            "description": "Las rutas de Aplicación no están en publicActions: sin sesión deben redirigir al login."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Borra las cookies para simular un visitante anónimo",
                  "pm.cookies.jar().clear(pm.request.url, () => {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sin sesión: responde 302', () => pm.response.to.have.status(302));",
                  "pm.test('Sin sesión: redirige a route=auth.login', () => pm.expect(pm.response.headers.get('Location') || '').to.include('route=auth.login'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "0.2 Login con credenciales inválidas",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?route=auth.authenticate",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "route",
                  "value": "auth.authenticate"
                }
              ]
            },
            "description": "",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{adminEmail}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "clave-incorrecta",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login inválido: responde 302', () => pm.response.to.have.status(302));",
                  "pm.test('Login inválido: redirige a route=auth.login', () => pm.expect(pm.response.headers.get('Location') || '').to.include('route=auth.login'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "0.3 Login como administrador",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?route=auth.authenticate",
