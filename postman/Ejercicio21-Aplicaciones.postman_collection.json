        {
          "name": "1.4 Listar aplicaciones y capturar el id creado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?route=aplicaciones.index",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "route",
                  "value": "aplicaciones.index"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const html = pm.response.text();",
                  "const nombre = pm.collectionVariables.get('appNombre');",
                  "pm.test('La aplicación creada aparece en la lista', () => pm.expect(html).to.include(nombre));",
                  "pm.test('Se muestra el mensaje de éxito', () => pm.expect(html).to.include('Aplicación registrada correctamente.'));",
                  "const esc = nombre.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');",
                  "const m = html.match(new RegExp(esc + '[\\\\s\\\\S]*?aplicaciones\\\\.show&(?:amp;)?id=([0-9a-f-]{36})'));",
                  "pm.test('Se pudo extraer el id (UUID)', () => pm.expect(m).to.not.be.null);",
                  "if (m) { pm.collectionVariables.set('appId', m[1]); }"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
